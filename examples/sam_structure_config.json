{
  "representation": "stft",
  "analysis": {
    "sampling_frequency": 1.0,
    "sampling_period": "1s",
    "window_id": null,
    "window_size": 256,
    "overlap": 128,
    "min_valid_ratio": 0.98,
    "min_valid_samples": 250,
    "max_interpolation_gap": 2
  },
  "msst": {
    "iteration_count": 3,
    "center": true,
    "window": "hann",
    "n_fft": 256,
    "window_length": 128,
    "hop_length": 4
  },
  "sam_image": {
    "transform": "log",
    "percentiles": [1.0, 99.0]
  },
  "sam": {
    "checkpoint": "checkpoints/sam2.1_hiera_small.pt",
    "model_config": "configs/sam2.1/sam2.1_hiera_s.yaml",
    "device": "auto"
  },
  "automatic_mask_generation": {
    "points_per_side": 32,
    "points_per_batch": 64,
    "pred_iou_thresh": 0.8,
    "stability_score_thresh": 0.8,
    "min_mask_region_area": 0
  },
  "guided_segmentation": {
    "enabled": true,
    "exclusion_seconds": 4.0,
    "neighborhood_seconds": 24.0,
    "epsilon": 1e-12,
    "min_valid_references": 6,
    "contrast_threshold": 6.0,
    "min_time_spacing_seconds": 4.0,
    "min_frequency_spacing_hz": 0.02,
    "max_points": 12,
    "mask_iou_threshold": 0.85
  },
  "output": {
    "html": "sam_stft_guided_comparison.html",
    "show": false
  }
}
