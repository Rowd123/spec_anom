      "wf_spectral_change_0",
      "wf_spectral_change_0_frequency",
      "wf_spectral_change_1",
      "wf_spectral_change_1_frequency"
    ],
    "hdbscan_features": [
      "wf_minimum",
      "wf_maximum",
      "wf_mean",
      "wf_variance",
      "wf_median",
      "wf_iqr",
      "wf_skewness",
      "wf_kurtosis",
      "wf_constant",
      "wf_band_0_power",
      "wf_band_1_power",
      "wf_band_2_power",
      "wf_band_3_power",
      "wf_acf_0",
      "wf_acf_1",
      "wf_acf_2",
      "wf_acf_3",
      "wf_acf_0_change",
      "wf_acf_1_change",
      "wf_acf_2_change",
      "wf_acf_3_change",
      "wf_spectral_change_0",
      "wf_spectral_change_0_frequency",
      "wf_spectral_change_1",
      "wf_spectral_change_1_frequency"
    ],
    "atypicality_exclude": [],
    "hdbscan_exclude": [],
    "log1p": [],
    "scaling": "none"
  },
  "split": {
    "train_fraction": 0.6,
    "calibration_fraction": 0.2,
    "evaluation_fraction": 0.2,
    "strategy": "chronological",
    "time_column": "window_start",
    "purge_overlap": true
  },
  "atypicality": {
    "backend": "auto",
    "type": "isolation_forest",
    "n_estimators": 200,
    "max_samples": "auto",
    "contamination": "auto",
    "n_jobs": -1
  },
  "spot": {
    "q": 0.001,
    "initial_quantile": 0.98,
    "min_excesses": 5
  },
  "hdbscan": {
    "backend": "auto",
    "min_cluster_size": 10,
    "min_samples": 5,
    "metric": "euclidean",
    "cluster_selection_method": "eom",
    "prediction_data": true
  },
  "reproducibility": {
    "random_seed": 42,
    "artifact_version": "1.0",
    "preprocessing_version": "1.0"
  }
